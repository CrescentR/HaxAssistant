{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HaxAssistant",
  "version": "2.1.3",
  "identifier": "com.haxassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "HaxAssistant · 海克斯助手",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      },
      {
        "label": "augment-overlay",
        "title": "HaxAssistant · 强化悬浮窗",
        "url": "overlay.html?overlay=augment",
        "width": 980,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "formula-item-overlay",
        "title": "HaxAssistant · 实时流派参考",
        "url": "overlay.html?overlay=item",
        "width": 460,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "champ-select-overlay",
        "title": "HaxAssistant · 阵容推荐",
        "url": "overlay.html?overlay=champ-select",
        "width": 420,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "player-scores-overlay",
        "title": "HaxAssistant · 玩家战力条",
        "url": "overlay.html?overlay=player-scores",
        "width": 640,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "death-hint-overlay",
        "title": "HaxAssistant · 阵亡提示",
        "url": "overlay.html?overlay=death-hint",
        "width": 380,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "item-launcher-overlay",
        "title": "HaxAssistant · 出装按钮",
        "url": "overlay.html?overlay=item-launcher",
        "width": 44,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNTRCMDJDMUY4OUNERDAKUldUUXpZa2ZMTEJVVVd0NnRnblFlWU8xTU00N1R4ZURHcHVpeVdDNjAvYytkaFd4eDR6c1hIS0wK",
      "endpoints": [
        "https://github.com/CrescentR/HaxAssistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/data": "data",
      "resources/models": "models",
      "resources/ocr-sidecar": "ocr-sidecar",
      "resources/ocr": "ocr"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
